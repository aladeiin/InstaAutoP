# Copy this file to ".env" (same folder) and fill in the values.
# Never share the .env file or commit it anywhere public.

# --- Claude (script writing + fact-check pass) ---
ANTHROPIC_API_KEY=

# --- Pexels (free stock footage): https://www.pexels.com/api/ ---
PEXELS_API_KEY=

# --- Public video hosting (Cloudflare R2 or any S3-compatible bucket) ---
# Instagram needs a public URL for each video, so the video is uploaded here first.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto
# Public base URL that serves the bucket, with no trailing slash,
# e.g. https://pub-xxxxxxxx.r2.dev
S3_PUBLIC_BASE_URL=

# --- Instagram Graph API ---
# Instagram professional (Creator/Business) account ID
IG_USER_ID=
# Long-lived access token (see README for how to get one that does not expire quickly)
IG_ACCESS_TOKEN=
